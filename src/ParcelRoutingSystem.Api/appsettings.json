{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "",
    "ApplyMigrationsOnStartup": false
  },
  "ParcelAuthentication": {
    "Mode": "OidcJwt",
    "Authority": "",
    "Audience": "",
    "DevelopmentAutoAuthenticate": false,
    "DevelopmentActor": "",
    "DevelopmentRoles": []
  },
  "Manifest": {
    "MaximumBytes": 2097152,
    "MaximumRows": 10000,
    "MaximumCharacters": 2000000,
    "TimeoutSeconds": 10
  },
  "BatchProcessor": {
    "Enabled": true,
    "IdleDelayMilliseconds": 500,
    "FailureDelayMilliseconds": 2000
  }
}
