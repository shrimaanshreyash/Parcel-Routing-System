{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "ParcelAuthentication": {
    "Mode": "Development",
    "DevelopmentAutoAuthenticate": true,
    "DevelopmentActor": "local-reviewer",
    "DevelopmentRoles": [
      "Operator",
      "InsuranceApprover",
      "RuleAdministrator"
    ]
  }
}
